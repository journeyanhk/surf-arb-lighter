# ---- 执行边车（sidecar）环境变量模板 ----
# 复制为 .env 并填入真实值。切勿把 .env 提交到 git。
#
# 安全默认：SIDECAR_DRY_RUN=true（只签名不发送）。确认无误后再改 false 接实盘。

SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8787

# 与 Node 后端 ARB_SIDECAR_TOKEN 必须完全一致；随便生成一个长随机串即可
SIDECAR_TOKEN=change-me-to-a-long-random-string

# true=只签名不发送（零资金风险）；接实盘时改为 false
SIDECAR_DRY_RUN=true

# 单笔名义额上限（USD），超过直接拒绝。先用很小的值做实盘验证，例如 15
SIDECAR_MAX_NOTIONAL_USD=15

# ---- Lighter 账户（API 私钥，非钱包助记词/以太坊私钥）----
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
# LIGHTER_CHAIN_ID=

# ---- RBLighter 账户 ----
RBLIGHTER_BASE_URL=https://api.rh.lighter.xyz
RBLIGHTER_ACCOUNT_INDEX=
RBLIGHTER_API_KEY_INDEX=
RBLIGHTER_API_PRIVATE_KEY=
# RBLIGHTER_CHAIN_ID=
