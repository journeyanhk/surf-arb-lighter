BACKEND_PORT=3001
SURF_API_KEY=

# ---- 本地数据库（自建部署）----
# 三选一（按优先级）：
#   A. 最省事：嵌入式 Postgres（PGlite），无需装数据库、无需密码，数据存本地文件夹。
#      只需设 LOCAL_DB_PATH，SURF_API_KEY 可留空。
LOCAL_DB_PATH=./data/arb
#   B. 你自己的 Postgres 服务（设了它会优先于 LOCAL_DB_PATH）：
DATABASE_URL=
#      例：postgres://arb:yourpassword@127.0.0.1:5432/arb
#   C. 两者都不设（工作室内）：自动使用 Surf 托管库。

# ---- 实盘执行边车（可选）----
# 不设置 ARB_SIDECAR_TOKEN 时，套利任务为纯模拟（零风险）。
# 设置后，且面板所有实盘开关打开时，才会通过边车下真实订单。
ARB_SIDECAR_URL=http://127.0.0.1:8787
ARB_SIDECAR_TOKEN=

