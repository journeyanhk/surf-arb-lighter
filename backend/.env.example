BACKEND_PORT=3001
SURF_API_KEY=

# ---- 本地数据库（自建部署推荐）----
# 设置 DATABASE_URL 后，套利数据（设置/任务/采样）存到你 VPS 本地的 Postgres，
# 不依赖 Surf 托管库；此时 SURF_API_KEY 可留空。
# 不设置时（工作室内）自动使用 Surf 托管库。
DATABASE_URL=
# 例：postgres://arb:yourpassword@127.0.0.1:5432/arb

# ---- 实盘执行边车（可选）----
# 不设置 ARB_SIDECAR_TOKEN 时，套利任务为纯模拟（零风险）。
# 设置后，且面板所有实盘开关打开时，才会通过边车下真实订单。
ARB_SIDECAR_URL=http://127.0.0.1:8787
ARB_SIDECAR_TOKEN=

